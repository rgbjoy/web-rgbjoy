# Dormant — Payload CMS and its database were dropped in favour of static data
# in src/app/data. Nothing reads these; kept in case Payload comes back.
SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=
DATABASE_URL=

# S3_BUCKET is dormant with Payload. The credentials below are NOT — the contact
# form reuses this IAM key for SES, whose user also carries ses:SendEmail.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Contact form
CONTACT_FROM=rgbjoy.com contact form <tom@rgbjoy.com>

# Dormant.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
