    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0",
    "pngjs": "^7.0.0"
