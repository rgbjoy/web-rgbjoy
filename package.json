    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@react-three/drei": "11.0.0-alpha.7",
    "@react-three/fiber": "10.0.0-alpha.5",
    "@react-three/postprocessing": "3.2.2",
    "@smithy/fetch-http-handler": "^5.8.1",
    "@thi.ng/color": "^5.8.33",
    "@thi.ng/color-palettes": "^1.5.64",
    "@vinext/cloudflare": "^1.3.3",
    "box3d.js": "^0.1.1",
    "fast-png": "^8.0.0",
    "glsl-noise": "^0.0.0",
    "glslify": "^7.1.1",
    "glslify-loader": "^2.0.0",
    "gpu-io": "^0.2.7",
    "gsap": "^3.15.1",
    "jose": "^6.2.17",
    "lenis": "^1.3.27",
    "lexical": "^0.53.0",
    "lil-gui": "^0.21.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postprocessing": "^6.39.6",
    "raw-loader": "^4.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "three": "^0.187.0",
    "vinext": "^1.4.4"
