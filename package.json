{
  "name": "web-rgbjoy",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "lint": "eslint",
    "ts:check": "tsc --noEmit",
    "test:discovery": "bun test --preload ./tests/cloudflare-env.ts src/app/data/catalog.test.ts",
    "update": "bun update --latest -i",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:types": "wrangler types --env-file .env.example"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@lexical/link": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-three/drei": "11.0.0-alpha.6",
    "@react-three/fiber": "10.0.0-alpha.5",
    "@react-three/postprocessing": "3.1.1",
    "@smithy/fetch-http-handler": "^5.8.0",
    "@thi.ng/color": "^5.8.33",
    "@thi.ng/color-palettes": "^1.5.64",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "box3d.js": "^0.1.1",
    "fast-png": "^8.0.0",
    "glsl-noise": "^0.0.0",
    "glslify": "^7.1.1",
    "glslify-loader": "^2.0.0",
    "gpu-io": "^0.2.7",
    "gsap": "^3.14.2",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lexical": "^0.51.0",
    "lil-gui": "^0.21.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "postprocessing": "^6.39.5",
    "raw-loader": "^4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "three": "^0.186.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.0",
    "pngjs": "^7.0.0"
  },
  "type": "module"
}
